{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "gestao-turmas-front": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environments.ts",
                  "with": "src/environments/environments.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "ssl": true,
            "sslCert": "./certs/localhost.pem",
            "sslKey": "./certs/localhost-key.pem"
          },
          "configurations": {
            "production": {
              "buildTarget": "gestao-turmas-front:build:production"
            },
            "development": {
              "buildTarget": "gestao-turmas-front:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "providersFile": "src/test-providers.ts",
            "setupFiles": [
              "src/test-setup.ts"
            ],
            "coverageInclude": [
              "src/**/*.ts"
            ],
            "coverageExclude": [
              "src/**/*.interface.ts",
              "src/**/*.enum.ts",
              "src/**/*.routes.ts",
              "src/**/*.config.ts",
              "src/environments/**",
              "src/main.ts"
            ],
            "coverageReporters": [
              "text-summary",
              "html",
              "lcovonly"
            ],
            "coverageThresholds": {
              "statements": 73.9,
              "branches": 82.6,
              "functions": 69.5,
              "lines": 73.7
            }
          },
          "configurations": {
            "escopo": {
              "coverage": true,
              "coverageInclude": [
                "src/app/shared/pipes/error-message.pipe.ts",
                "src/app/shared/pipes/error-params.pipe.ts",
                "src/app/shared/utils/primeiro-erro-de.util.ts",
                "src/app/shared/utils/causas-de-invalidez.util.ts",
                "src/app/shared/constants/limites-turma.const.ts",
                "src/app/shared/components/mensagem.component/**/*.ts",
                "src/app/shared/components/form-field-select.component/**/*.ts",
                "src/app/shared/components/stepper.component/**/*.ts",
                "src/app/shared/components/passos/passo-informacoes.component/**/*.ts",
                "src/app/features/turma/turma-index.component.ts",
                "src/app/features/turma/turma-cadastro.component/turma-cadastro.component.ts"
              ],
              "coverageThresholds": {
                "statements": 80,
                "branches": 75,
                "functions": 80,
                "lines": 80
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
