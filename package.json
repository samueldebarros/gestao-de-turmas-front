{
  "name": "gestao-turmas-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:cov": "ng test --coverage --watch=false",
    "verify": "npm run verify:format && npm run verify:conformidade && npm run verify:test && npm run verify:build && node scripts/verify-marcador.mjs",
    "verify:format": "node scripts/verify-format.mjs",
    "verify:conformidade": "node scripts/verify-conformidade.mjs",
    "verify:test": "ng test --watch=false --coverage",
    "verify:build": "ng build && node scripts/verify-bundle.mjs",
    "verify:escopo": "ng test --watch=false --configuration escopo",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vercel": "59.10.0",
    "vitest": "^4.0.8"
  }
}
